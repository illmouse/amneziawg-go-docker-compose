# .env

# Mandatory params

# Public endpoint
WG_ENDPOINT=

# Optional default params

# Proxy config
PROXY_SOCKS5_ENABLED=true
PROXY_SOCKS5_PORT="4128"
PROXY_SOCKS5_AUTH_ENABLED=false

PROXY_HTTP_ENABLED=false
PROXY_HTTP_PORT="3128"
PROXY_HTTP_AUTH_ENABLED=false

PROXY_CUSTOM_CONFIG=false

METRICS_ENABLED=false
METRICS_PORT="9586"
METRICS_INTERVAL ="15"

# Name of the VPN interface inside the container
WG_IFACE=wg0
# Server IP and subnet
WG_ADDRESS=10.100.0.1/24
# VPN port to accept connections
WG_PORT=13440
# Number of peers to create
WG_PEER_COUNT=1
# Client mode: Connects to peers using configs from config/client_peers/
WG_MODE=server
# Master peer - peer config filename that will be main peer
# if set - once become available tunnel will always be switched to this peer
MASTER_PEER=peer1.conf
# log level to use - ERROR,INFO,WARN,DEBUG
LOG_LEVEL=INFO
# UDP protocol to be used for obfuscation. Available options: SIP, DNS, QUIC, STUN-WEBRTC
UDP_SIGNATURE=QUIC

# AmneziaWG tunable parameters
Jc=3                           
Jmin=1
Jmax=50
S1=25
S2=72
S3=25
S4=76
H1=1411927821
H2=1212681123
H3=1327217326
H4=1515483925

# AmneziaWG 3.1 parameters (all optional; empty = disabled, 2.x-compatible)
# HeaderProtectionKey: base64 32-byte key; encrypts packet headers (ChaCha20,
# nonce from S-prefix). REQUIRES S1-S4 >= 12. When set, H1-H4 are recommended
# to stay at standard values 1/2/3/4. Must match server and all peer configs.
#HeaderProtectionKey=
# ContentPaddingAddition: random bytes added to payload, e.g. 16-64 (client-side)
#ContentPaddingAddition=16-64
# RekeyAfterTime: seconds before re-handshake, e.g. 3000-4000 (client-side)
#RekeyAfterTime=3000-4000
# RekeyTimeout: handshake timeout in seconds, e.g. 5-10 (client-side)
#RekeyTimeout=5-10
# RejectAfterTime: seconds after which a new handshake is forced (client-side)
#RejectAfterTime=180-190
# KeepaliveTimeout: keepalive interval in seconds, e.g. 8-15 (client-side)
#KeepaliveTimeout=8-15
# MaxHandshakeAttempts: max handshake retries, e.g. 10-20 (client-side)
#MaxHandshakeAttempts=15
# RandomTrailers: on/off - random trailing bytes on packets
#RandomTrailers=on
# DisableCookies: on/off - suppress Cookie Reply packets
#DisableCookies=off